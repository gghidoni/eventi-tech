includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:

    paths:
        - app/

    # Level 10 is the highest level
    level: 7

    ignoreErrors:
        # Trait usato dentro componente Volt inline in Blade, non risolvibile da PHPStan come usage classica.
        - identifier: trait.unused
          path: app/Livewire/Concerns/HasBookmarkToggle.php

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php
