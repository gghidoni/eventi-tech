APP_NAME="Eventi Tech"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8083
APP_TIMEZONE=Europe/Rome

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runtime locale canonico: PostgreSQL nel servizio Compose `postgres`.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=eventi_tech
DB_USERNAME=eventi_tech
DB_PASSWORD=eventi_tech_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Temporaneo finche il runtime non include un worker esplicito.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Search locale canonica: Scout + Meilisearch Compose.
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=false
MEILISEARCH_URL=http://meilisearch:7700
MEILI_ENV=development
MEILI_MASTER_KEY=eventi-tech-local-master-key

# Mail locale canonica: Mailpit Compose.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@eventi-tech.local"
MAIL_FROM_NAME="${APP_NAME}"

# Porte host e nomi container sovrascrivibili per smoke isolati.
FORWARD_APP_PORT=8083
FORWARD_APP_FPM_PORT=9000
FORWARD_VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_MEILISEARCH_PORT=7700
FORWARD_MAILPIT_SMTP_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
APP_CONTAINER_NAME=eventi-tech
NGINX_CONTAINER_NAME=eventi-tech-nginx
POSTGRES_CONTAINER_NAME=eventi-tech-postgres
MEILISEARCH_CONTAINER_NAME=eventi-tech-meilisearch
MAILPIT_CONTAINER_NAME=eventi-tech-mailpit

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OAuth Social (fallback automatico su APP_URL se REDIRECT_URI e vuota)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Tooling locale opzionale, non usato dal runtime Laravel.
CONTEXT7_API_KEY=

VITE_APP_NAME="${APP_NAME}"
