{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "eventi-tech",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0",
        "npm": ">=11"
    },
    "scripts": {
        "prebuild": "rm -f public/hot",
        "build": "vite build",
        "dev": "vite",
        "security:audit": "npm audit --omit=dev --audit-level=high",
        "prefrontend:test": "rm -f public/hot",
        "frontend:install": "playwright install chromium",
        "frontend:test": "playwright test",
        "frontend:test:headed": "playwright test --headed --project=chromium",
        "frontend:test:ui": "playwright test --ui",
        "frontend:test:debug": "playwright test --debug --project=chromium",
        "prefrontend:audit": "rm -f public/hot",
        "frontend:audit": "node scripts/frontend/audit.mjs",
        "frontend:check": "npm run frontend:test && npm run frontend:audit"
    },
    "dependencies": {
        "axios": "^1.17.0",
        "flatpickr": "^4.6.13"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.61.1",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.0",
        "lightningcss-linux-x64-gnu": "^1.32.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.0",
        "autoprefixer": "^10.5.0",
        "chrome-launcher": "^1.2.1",
        "concurrently": "^9.2.1",
        "laravel-vite-plugin": "^3.1.0",
        "lighthouse": "^13.3.0",
        "tailwindcss": "^4.3.0",
        "vite": "^8.0.16"
    },
    "overrides": {
        "lodash": "4.18.1",
        "vite-plugin-full-reload": {
            "picomatch": "2.3.2"
        }
    }
}
