{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "frontend:install": "playwright install chromium",
        "frontend:test": "playwright test",
        "frontend:test:headed": "playwright test --headed --project=chromium",
        "frontend:test:ui": "playwright test --ui",
        "frontend:test:debug": "playwright test --debug --project=chromium",
        "frontend:audit": "lhci autorun --config=.lighthouserc.cjs",
        "frontend:check": "npm run frontend:test && npm run frontend:audit"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.11",
        "autoprefixer": "^10.4.20",
        "axios": "^1.7.4",
        "concurrently": "^9.0.1",
        "flatpickr": "^4.6.13",
        "laravel-vite-plugin": "^2.0",
        "tailwindcss": "^4.0.7",
        "vite": "^7.0.4"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "devDependencies": {
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.60.0",
        "@tailwindcss/forms": "^0.5.10"
    }
}
